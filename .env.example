# Copy to .env.local. Never commit .env.local.

# GitHub fine-grained personal access token, public repositories, read-only. Raises the rate limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Anthropic API key. Used server side only.
ANTHROPIC_API_KEY=

# Daily spend cap in USD. When reached, the app serves cached answers only until midnight UTC. Start at 5.
DAILY_CAP_USD=5

# Vercel KV (an Upstash Redis store): Vercel sets both when the store is linked. Required in production (the visitor and cap counters, the cache); optional in dev, where they are in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=



{
  "name": "generative-ui-github",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@genui-github/web",
    "typecheck": "turbo typecheck",
    "lint": "eslint . && node scripts/check-copy.mjs && node scripts/check-css.mjs",
    "test": "turbo test",
    "e2e": "pnpm --filter @genui-github/web e2e",
    "a11y": "pnpm --filter @genui-github/web a11y",
    "lighthouse": "pnpm --filter @genui-github/web lighthouse",
    "tokens:build": "node scripts/tokens-build.mjs && node scripts/tokens-ts.mjs",
    "samples:refresh": "pnpm --filter @genui-github/data samples:refresh",
    "compositions:refresh": "pnpm --filter @genui-github/composer compositions:refresh",
    "evals:run": "pnpm --filter @genui-github/evals evals:run",
    "evals:check": "pnpm --filter @genui-github/evals evals:check",
    "check:secrets": "bash scripts/check-secrets.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsup": "8.5.1",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}

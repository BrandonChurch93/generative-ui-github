{
  "name": "@genui-github/mcp-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/flatten.mjs",
    "start": "tsx src/main.ts",
    "start:stdio": "tsx src/main.ts --stdio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "vite build && node scripts/flatten.mjs && playwright test"
  },
  "dependencies": {
    "@genui-github/composer": "workspace:*",
    "@genui-github/core": "workspace:*",
    "@genui-github/data": "workspace:*",
    "@genui-github/renderer": "workspace:*",
    "@genui-github/ui": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "gsap": "^3.15.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }

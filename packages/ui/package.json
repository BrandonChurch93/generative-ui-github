{
  "name": "@genui-github/ui",
  "version": "0.1.0",
  "description": "The component catalog behind Generative UI for GitHub Repos: pieces, their schemas, their motion, and the registry a model composes from.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/specs.ts",
    "./catalog": "./src/catalog/index.ts",
    "./motion": "./src/motion/index.ts",
    "./styles.css": "./src/styles/global.css",
    "./rows.module.css": "./src/styles/rows.module.css",
    "./shell": "./src/shell/index.ts",
    "./pieces": "./src/pieces.ts",
    "./schemas": "./src/schemas.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./pieces": {
        "types": "./dist/pieces.d.ts",
        "import": "./dist/pieces.js"
      },
      "./motion": {
        "types": "./dist/motion.d.ts",
        "import": "./dist/motion.js"
      },
      "./registry": {
        "types": "./dist/registry.d.ts",
        "import": "./dist/registry.js"
      },
      "./styles.css": "./dist/styles.css",
      "./schemas": {
        "types": "./dist/schemas.d.ts",
        "import": "./dist/schemas.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/package-styles.mjs . ../../design-system/tokens.css src/styles/global.css dist/index.css dist/pieces.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "motion": "^14.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@genui-github/core": "workspace:*",
    "@genui-github/data": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
